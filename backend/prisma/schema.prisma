generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String                 @unique @db.VarChar(255)
  password_hash       String                 @db.VarChar(255)
  name                String                 @db.VarChar(100)
  created_at          DateTime               @default(now()) @db.Timestamptz
  resumes             Resume[]
  interview_sessions  InterviewSession[]
  
  // New profile fields
  profile_picture     String?                @db.Text
  preferred_roles     String?                @db.VarChar(255)
  linkedin_url        String?                @db.VarChar(255)
  github_url          String?                @db.VarChar(255)
  portfolio_url       String?                @db.VarChar(255)
}

model Resume {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String             @db.Uuid
  user                User               @relation(fields: [user_id], references: [id])
  filename            String             @db.VarChar(255)
  raw_text            String?
  parsed_structure    Json?
  pdf_storage_url     String?            @db.VarChar(512)
  version_name        String?            @db.VarChar(100)
  uploaded_at         DateTime           @default(now()) @db.Timestamptz
  is_default          Boolean            @default(false)
  analyses            ResumeAnalysis[]
  interview_sessions  InterviewSession[]
}

model ResumeAnalysis {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resume_id           String   @db.Uuid
  resume              Resume   @relation(fields: [resume_id], references: [id])
  jd_text             String?
  jd_text_hash        String?  @db.VarChar(64)
  analysis_result     Json?
  ats_score           Int?
  generated_at        DateTime @default(now()) @db.Timestamptz
}

model InterviewSession {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resume_id           String                  @db.Uuid
  resume              Resume                  @relation(fields: [resume_id], references: [id])
  user_id             String                  @db.Uuid
  user                User                    @relation(fields: [user_id], references: [id])
  session_type        String                  @db.VarChar(20)
  question_count      Int                     @default(0)
  duration_seconds    Int                     @default(0)
  overall_score       Int?
  started_at          DateTime                @default(now()) @db.Timestamptz
  ended_at            DateTime?               @db.Timestamptz
  feedback_summary    Json?
  feedback_logs       InterviewFeedbackLog[]
}

model InterviewFeedbackLog {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id          String           @db.Uuid
  session             InterviewSession @relation(fields: [session_id], references: [id])
  question_number     Int
  question_text       String
  user_answer         String?
  feedback            Json?
  confidence_score    Int?
  created_at          DateTime         @default(now()) @db.Timestamptz
}
